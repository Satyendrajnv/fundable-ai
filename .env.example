# Environment Configuration for Fundable AI

# Node Environment
NODE_ENV=development
PORT=8080

# Google Cloud Platform Setup
GCP_PROJECT_ID=fundable-ai-dev
GCP_REGION=us-central1

# Firebase Configuration
FIREBASE_PROJECT_ID=fundable-ai-dev

# Firestore & Storage Buckets
FIRESTORE_DATABASE_ID=(default)
GCS_BUCKET_DOCUMENTS=fundable-ai-documents-dev
GCS_BUCKET_EXPORTS=fundable-ai-exports-dev

# Vertex AI / Gemini API Setup
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL_EXTRACTION=gemini-2.0-flash-001
GEMINI_MODEL_GENERATION=gemini-2.0-flash-001

# Feature Flags
ENABLE_MOCK_GCP=true
